# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID for Web Application)
# Authorized JavaScript origins: http://localhost:3000, https://saimanoj01.github.io
# Authorized redirect URIs: http://localhost:3000, https://saimanoj01.github.io/pragya/
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Base path for Vite build (set to /pragya/ for GitHub Pages deployment)
VITE_BASE_PATH=./
